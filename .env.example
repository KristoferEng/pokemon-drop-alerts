# Postgres connection string (Render Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Verify Service SID (Console > Verify > Services)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Messaging Service SID for sending alerts (Console > Messaging > Services)
# Must be 10DLC-registered for US SMS at scale
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Worker config
WORKER_CYCLE_SECONDS=180          # how often to run a full scrape cycle
ALERT_COOLDOWN_HOURS=6            # don't re-alert the same product within this window
DRY_RUN=false                     # if true, worker logs alerts instead of texting

# Optional: comma-separated list of phone numbers to allowlist for testing
# TEST_PHONES=+15555550100,+15555550101
